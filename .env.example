# GOAL API is the default provider. Keep this server-side key private.
FOOTBALL_DATA_PROVIDER=goal-api
GOAL_API_KEY=

# Season starting year; 2026 means the 2026/27 season.
FOOTBALL_DATA_SEASON=2026
GOAL_API_SEASON=2026

# Optional override for testing against a compatible GOAL API endpoint.
# GOAL_API_BASE_URL=https://api.goal-api.com/v1

# Optional API-Football provider settings. To use it instead, set
# FOOTBALL_DATA_PROVIDER=api-football and supply an API_FOOTBALL_KEY.
API_FOOTBALL_KEY=
API_FOOTBALL_TEAM_ID=529
API_FOOTBALL_TEAM_NAME=Barcelona
API_FOOTBALL_TEAM_COUNTRY=Spain
API_FOOTBALL_SEASON=2026

# Scheduled runs make no API request outside this post-kickoff window.
FOOTBALL_SYNC_WINDOW_START_MINUTES=95
FOOTBALL_SYNC_WINDOW_END_MINUTES=360

# Optional override for testing against a compatible API-Football endpoint.
# API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
